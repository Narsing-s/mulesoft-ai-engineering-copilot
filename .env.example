# AI provider: mock, offline, groq, or another OpenAI-compatible provider
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
# Smaller default keeps interactive development responsive and reduces TPD usage.
# Set AI_MODEL to a larger model when your provider quota supports it.
AI_MODEL=llama-3.1-8b-instant
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=1536
AI_TIMEOUT_SECONDS=60

# Optional external deterministic DataWeave execution service
DW_EXECUTOR_URL=
